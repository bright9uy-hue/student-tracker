@echo off
chcp 65001 >nul
title تحديث البرنامج من GitHub

echo ======================================================
echo    جاري جلب أحدث التحديثات البرمجية من GitHub...
echo ======================================================

cd /d "%~dp0"
git pull origin main

if errorlevel 1 (
    echo.
    echo ======================================================
    echo    ❌ فشل التحديث! لم يتم جلب أحدث الملفات من GitHub.
    echo    راجع رسالة الخطأ أعلاه ^(اتصال الإنترنت، أو تعديلات
    echo    محلية غير محفوظة تمنع التحديث^).
    echo ======================================================
    pause
    exit /b 1
)

echo.
echo ======================================================
echo    ✅ تم تحديث جميع الملفات البرمجية بنجاح!
echo ======================================================
pause